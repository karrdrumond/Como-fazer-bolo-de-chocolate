:root { 
    --cor-primaria: #183C;
    --cor-secundaria: #3a638e;
    --cor-fundo: #FFFFFF;
    --cor-texto: #151426;
    --cor-contraste: #f3eef7;
    --cor-botao: #f9f9f9;
    --fonte-texto: 'Segoe UI' , sans-serif;
}

*{
    transition: background-color: 0.3 ease;
    }

.tema-escuro{
    --cor-primaria: #183C;
    --cor-secundaria: #3a638e;
    --cor-fundo: #FFFFFF;
    --cor-texto: #151426;
    --cor-contraste: #f3eef7;
    --cor-botao: #f9f9f9;
}

.tema-escuro a{
    color: var( --cor-secundaria)
}

.tema-escuro a { 
    color: var( --cor-texto)
}

.tema-escuro header p { 
var( --cor-contraste)
}

.tema-escuro .btn-tema-escuro{
    background-color:( var ( --cor-secundaria
}
]

body{
    max-width: 100vw;
    font-family: var(--fonte-texto;
}

header{
    background-color: #183C;
    color: #FFFFFF;
    text-align: center;
    margin: 0 auto;
    padding: 16px;
}

main{
    background-color: #FFFFFF;
    color: aquamarine;
    margin: 0 auto;
    padding: 16px;
    
    display: flex;
    flex-wrap: wrap;
}

article{
    display: flex;
    box-shadow: 0 2px 6px rgba( 0, 0, 0, 0.3

    margin: 16px;
    gap: 16px;
    padding: 16px;

    flex: 1 1 30%;

    flex-direction: column;
    align-items: center;
    text-align: center;
    justify-content: center;
}

img{
    width: 80px;
    height: 80px;
}

    .artigo-autor { 
        font-weight: bold;
    }

    .btn-tema-escuro{
        position: fixed;
        bottom: 16px;
        right: 16px;
        font-size: 32px;
        padding: 12px;
        blackground-color: var:( --cor-primaria
        border-radius: 30%;

    }